generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Restaurant {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  logo      String?
  email     String?
  phone     String?
  address   String?
  currency  String   @default("JPY")
  timezone  String   @default("Asia/Tokyo")
  vatRate   Float    @default(10)
  serviceCharge Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  setMenus       SetMenu[]
  tables         Table[]
  orders         Order[]
  invoices       Invoice[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("Waiter")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  orders Order[]
}

model MenuCategory {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  menuItems MenuItem[]
}

model MenuItem {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  price        Float
  courseType   String   @default("Main")
  isAvailable  Boolean  @default(true)
  image        String?
  isWine       Boolean  @default(false)
  wineVintage  Int?
  wineRegion   String?
  wineAppellation String?
  wineGrape    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categoryId Int
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  modifiers  MenuItemModifier[]
  allergens  ItemAllergen[]
  setMenuItems SetMenuItem[]
  orderItems OrderItem[]
}

model MenuItemModifier {
  id        Int    @id @default(autoincrement())
  name      String
  price     Float  @default(0)
  maxSelect Int    @default(1)

  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model Allergen {
  id   Int    @id @default(autoincrement())
  name String @unique
  icon String

  items ItemAllergen[]
}

model ItemAllergen {
  itemId    Int
  menuItem  MenuItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  allergenId Int
  allergen  Allergen  @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([itemId, allergenId])
}

model SetMenu {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  items SetMenuItem[]
}

model SetMenuItem {
  id         Int @id @default(autoincrement())
  courseType String

  setMenuId Int
  setMenu   SetMenu @relation(fields: [setMenuId], references: [id], onDelete: Cascade)

  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model Table {
  id        Int      @id @default(autoincrement())
  number    String
  capacity  Int      @default(4)
  section   String   @default("Main")
  status    String   @default("Available")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  orders Order[]
}

model Order {
  id         Int      @id @default(autoincrement())
  status     String   @default("Pending")
  coverCount Int      @default(1)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tableId Int
  table   Table @relation(fields: [tableId], references: [id])

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  items     OrderItem[]
  invoices  Invoice[]
}

model OrderItem {
  id         Int    @id @default(autoincrement())
  quantity   Int    @default(1)
  price      Float
  courseType String
  status     String @default("Pending")

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  modifiers String?
}

model Invoice {
  id            Int      @id @default(autoincrement())
  subtotal      Float
  vatAmount     Float
  vatRate       Float
  serviceCharge Float    @default(0)
  discount      Float    @default(0)
  total         Float
  paymentMethod String?
  paidAt        DateTime?
  createdAt     DateTime @default(now())

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  payments Payment[]
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Float
  method    String
  createdAt DateTime @default(now())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id          Int      @id @default(autoincrement())
  name        String
  sku         String?
  quantity    Float    @default(0)
  unit        String   @default("pcs")
  minStock    Float    @default(0)
  price       Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  movements StockMovement[]
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  type      String
  quantity  Float
  note      String?
  createdAt DateTime @default(now())

  itemId Int
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}
